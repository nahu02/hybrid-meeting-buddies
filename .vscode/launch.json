{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Galene",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/galene.go"
        },
        {
            // plain HTTP (http://localhost:8444), /assignment/ forwarded
            // to the Vite dev server below
            "name": "Galene (dev, with assignment)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/galene.go",
            "cwd": "${workspaceFolder}",
            "args": ["-insecure", "-assignment", "http://localhost:5173"]
        },
        {
            "name": "Assignment service",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/buddy-assignment-app/server/index.js",
            "cwd": "${workspaceFolder}/buddy-assignment-app",
            "env": { "GALENE_URL": "http://localhost:8444" },
            "console": "integratedTerminal"
        },
        {
            // the assignment page with hot reload; forwards
            // /assignment/api to the assignment service
            "name": "Assignment page (Vite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/buddy-assignment-app"
        }
    ],
    "compounds": [
        {
            // Then open http://localhost:8444/group/test/?role=leader
            // (and ?role=remote / ?role=buddyDevice in other tabs)
            "name": "Everything (dev)",
            "configurations": [
                "Galene (dev, with assignment)",
                "Assignment service",
                "Assignment page (Vite)"
            ],
            "stopAll": true
        }
    ]
}
